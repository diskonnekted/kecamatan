# Environment configuration template
# Copy to .env on server: cp .env.example .env && nano .env

# Node environment
NODE_ENV=production

# Port untuk Next.js (harus match dengan App Port di CloudPanel)
PORT=3033

# Path absolut ke file SQLite database
# Default: .data/portal.db di root aplikasi
DATABASE_PATH=/home/rapidnet-banjarmangu/htdocs/banjarmangu.rapidnet.id/.data/portal.db

# Secret untuk session admin (WAJIB diganti dengan random string)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-48-byte-random-hex-string
